---
import { Image } from 'astro:assets';
import type { LocalImageProps } from 'astro:assets';

interface Props {
  title: string;
  image: LocalImageProps['src'];
  url: string;
  description: string;
  byline: string;
}

const { title, image, url, description, byline } = Astro.props;
---

<div class="overflow-hidden rounded-xl border border-neutral-200 bg-white dark:border-neutral-800 dark:bg-neutral-900">
  <div class="aspect-4/3 overflow-hidden">
    <Image src={image} alt={title} class="h-full w-full object-cover" width={400} height={300} />
  </div>
  <div class="p-4">
    <h3 class="font-medium">
      <a href={url} class="text-neutral-900 hover:text-accent-600 dark:text-neutral-100 dark:hover:text-accent-100">
        {title}
      </a>
    </h3>
    <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">{description}</p>
    <p class="mt-2 text-xs text-neutral-500 dark:text-neutral-500">{byline}</p>
  </div>
</div>
