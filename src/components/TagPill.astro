---
interface Props {
  tag: string;
  href?: string;
}

const { tag, href } = Astro.props;
const classes = 'inline-block rounded-full bg-accent-50 px-2.5 py-0.5 text-xs font-medium text-accent-700 dark:bg-neutral-800 dark:text-accent-100';
---

{href ? (
  <a href={href} class:list={[classes, 'hover:bg-accent-100 dark:hover:bg-neutral-700']}>{tag}</a>
) : (
  <span class={classes}>{tag}</span>
)}
