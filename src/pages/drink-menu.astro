---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const page = await getEntry('pages', 'drink-menu');
if (!page) throw new Error('Missing "drink-menu" entry in the pages collection');
const { Content } = await render(page);
---

<BaseLayout title={page.data.title}>
  <article class="prose prose-neutral max-w-none dark:prose-invert">
    <h1 class="text-3xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-100">{page.data.title}</h1>
    <Content />
  </article>
</BaseLayout>
