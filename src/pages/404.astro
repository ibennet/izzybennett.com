---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found">
  <div class="py-16 text-center">
    <h1 class="text-3xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-100">Page not found</h1>
    <p class="mt-3 text-neutral-600 dark:text-neutral-400">
      The page you're looking for doesn't exist.
    </p>
    <a href="/" class="mt-6 inline-block text-accent-600 hover:underline dark:text-accent-100">Go home</a>
  </div>
</BaseLayout>
