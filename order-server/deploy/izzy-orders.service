[Unit]
Description=Izzy's Cafe order server
After=network.target

[Service]
WorkingDirectory=/home/pi/izzybennett.com/order-server
# Bind so the VPS can reach it over Tailscale. 0.0.0.0 is fine — Tailscale + home NAT
# keep port 8000 off the public internet, and CORS in the app locks browser callers to
# the site origin.
ExecStart=/home/pi/izzybennett.com/order-server/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
User=pi

[Install]
WantedBy=multi-user.target
